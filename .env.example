# Supabase public client credentials (safe for browser with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional fallback if using legacy Supabase anon JWT key instead of publishable key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional site origin override for production OAuth callbacks (e.g. https://sayagain.vercel.app)
# NEXT_PUBLIC_SITE_URL=http://localhost:5001

# Admin-only key for CLI episode publishing (`pnpm episode:publish`).
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to browser code.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared secret for POST /api/publish/episode.
# Set the same value in english-one-minute/.env as SAYAGAIN_PUBLISH_SECRET,
# and in the Vercel project. english-one-minute stays local and calls this deployment.
# SAYAGAIN_PUBLISH_SECRET=replace-with-a-long-random-string
